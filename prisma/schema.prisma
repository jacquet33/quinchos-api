generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════
// USUARIOS
// ═══════════════════

model Usuario {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   @map("password_hash")   // null si entra con Google/Apple
  nombre        String
  telefono      String?
  avatar        String?
  rol           Rol       @default(USUARIO)
  verificado    Boolean   @default(false)

  // Login social
  proveedor     Proveedor @default(EMAIL)
  googleId      String?   @unique @map("google_id")
  appleId       String?   @unique @map("apple_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  quinchos      Quincho[]     @relation("PropietarioQuinchos")
  reservas      Reserva[]
  resenas       Resena[]
  favoritos     Favorito[]
  dispositivos  Dispositivo[]

  @@map("usuarios")
}

enum Rol {
  USUARIO
  PROPIETARIO
  ADMIN
}

enum Proveedor {
  EMAIL
  GOOGLE
  APPLE
}

// ═══════════════════
// QUINCHOS / ESPACIOS
// ═══════════════════

model Quincho {
  id                  String    @id @default(cuid())
  nombre              String
  descripcion         String
  direccion           String
  ciudad              String
  provincia           String
  latitud             Float
  longitud            Float
  precioHora          Int       @map("precio_hora")
  precioDia           Int       @map("precio_dia")
  capacidadMin        Int       @map("capacidad_min")
  capacidadMax        Int       @map("capacidad_max")
  tipo                TipoEspacio
  disponible          Boolean   @default(true)
  horarioApertura     String    @map("horario_apertura")
  horarioCierre       String    @map("horario_cierre")
  calificacionProm    Float     @default(0) @map("calificacion_prom")
  totalResenas        Int       @default(0) @map("total_resenas")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  propietarioId       String    @map("propietario_id")
  propietario         Usuario   @relation("PropietarioQuinchos", fields: [propietarioId], references: [id])

  imagenes            QuinchoImagen[]
  amenidades          QuinchoAmenidad[]
  reservas            Reserva[]
  resenas             Resena[]
  favoritos           Favorito[]
  agenda              AgendaDia[]
  bloqueos            BloqueoFecha[]
  serviciosExtra      ServicioExtra[]

  @@index([ciudad])
  @@index([tipo])
  @@index([propietarioId])
  @@index([calificacionProm(sort: Desc)])
  @@map("quinchos")
}

enum TipoEspacio {
  QUINCHO
  SALON
  QUINTA
  TERRAZA
  JARDIN
}

model QuinchoImagen {
  id          String  @id @default(cuid())
  url         String
  orden       Int     @default(0)
  quinchoId   String  @map("quincho_id")
  quincho     Quincho @relation(fields: [quinchoId], references: [id], onDelete: Cascade)

  @@map("quincho_imagenes")
}

model QuinchoAmenidad {
  id          String    @id @default(cuid())
  amenidad    Amenidad
  quinchoId   String    @map("quincho_id")
  quincho     Quincho   @relation(fields: [quinchoId], references: [id], onDelete: Cascade)

  @@unique([quinchoId, amenidad])
  @@map("quincho_amenidades")
}

enum Amenidad {
  // Cocina y comida
  PARRILLA
  HORNO_BARRO
  COCINA
  HELADERA
  FREEZER
  VAJILLA
  MICROONDAS
  // Espacios
  PILETA
  PILETA_CLIMATIZADA
  TECHADO
  JARDIN
  QUINCHO_CERRADO
  DECK
  // Niños
  JUEGOS_NINOS
  PELOTERO
  HAMACAS
  TOBOGAN
  ARENERO
  // Entretenimiento
  MUSICA
  PROYECTOR
  METEGOL
  PING_PONG
  POOL
  CANCHA_FUTBOL
  CANCHA_TENIS
  // Servicios
  WIFI
  AIRE_ACONDICIONADO
  CALEFACCION
  ESTACIONAMIENTO
  SEGURIDAD
  BANO
  DUCHA
  VESTUARIO
  MESAS_SILLAS
  ILUMINACION
  ACCESIBLE
  // Otros
  APTO_MASCOTAS
  FOGON
  ASADOR_CRIOLLO
}


// ═══════════════════
// SERVICIOS EXTRA (opcionales con costo)
// ═══════════════════

model ServicioExtra {
  id            String       @id @default(cuid())
  nombre        String                                 // "Pelotero inflable" / "Pileta"
  descripcion   String?
  tipo          TipoServicio @default(ADICIONAL)
  precio        Int          @default(0)               // ADICIONAL: cuánto suma. INCLUIDO: cuánto descuenta si lo quitan
  icono         String?
  disponible    Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")

  quinchoId     String    @map("quincho_id")
  quincho       Quincho   @relation(fields: [quinchoId], references: [id], onDelete: Cascade)

  reservas      ReservaServicio[]

  @@index([quinchoId])
  @@map("servicios_extra")
}

enum TipoServicio {
  ADICIONAL   // No viene incluido, el cliente lo suma y paga de más
  INCLUIDO    // Viene incluido, si el cliente no lo quiere paga menos
}

model ReservaServicio {
  id                String        @id @default(cuid())
  precioUnitario    Int           @map("precio_unitario")
  montoAplicado     Int           @default(0) @map("monto_aplicado")  // + si suma, - si descuenta
  incluido          Boolean       @default(true)                       // false = el cliente lo quitó
  cantidad          Int           @default(1)

  reservaId         String        @map("reserva_id")
  reserva           Reserva       @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  servicioExtraId   String        @map("servicio_extra_id")
  servicioExtra     ServicioExtra @relation(fields: [servicioExtraId], references: [id])

  @@unique([reservaId, servicioExtraId])
  @@map("reserva_servicios")
}

// ═══════════════════
// AGENDA / DISPONIBILIDAD
// ═══════════════════

model AgendaDia {
  id              String    @id @default(cuid())
  diaSemana       Int                               // 0=domingo, 1=lunes...6=sábado
  habilitado      Boolean   @default(true)
  horaApertura    String    @map("hora_apertura")   // "08:00"
  horaCierre      String    @map("hora_cierre")     // "23:00"
  precioEspecial  Int?      @map("precio_especial") // precio diferente para ese día (ej: finde más caro)

  quinchoId       String    @map("quincho_id")
  quincho         Quincho   @relation(fields: [quinchoId], references: [id], onDelete: Cascade)

  @@unique([quinchoId, diaSemana])
  @@map("agenda_dias")
}

model BloqueoFecha {
  id          String    @id @default(cuid())
  fecha       DateTime  @db.Date
  motivo      String?                               // "Mantenimiento", "Uso personal", etc.
  createdAt   DateTime  @default(now()) @map("created_at")

  quinchoId   String    @map("quincho_id")
  quincho     Quincho   @relation(fields: [quinchoId], references: [id], onDelete: Cascade)

  @@unique([quinchoId, fecha])
  @@map("bloqueo_fechas")
}

// ═══════════════════
// RESERVAS
// ═══════════════════

model Reserva {
  id                String        @id @default(cuid())
  fecha             DateTime      @db.Date
  horaInicio        String        @map("hora_inicio")
  horaFin           String        @map("hora_fin")
  cantidadPersonas  Int           @map("cantidad_personas")
  precioTotal       Int           @map("precio_total")
  estado            EstadoReserva @default(PENDIENTE)
  notas             String?
  motivoCancelacion String?       @map("motivo_cancelacion")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  usuarioId         String        @map("usuario_id")
  usuario           Usuario       @relation(fields: [usuarioId], references: [id])
  quinchoId         String        @map("quincho_id")
  quincho           Quincho       @relation(fields: [quinchoId], references: [id])

  resena            Resena?
  servicios         ReservaServicio[]
  invitacion        Invitacion?

  @@index([usuarioId])
  @@index([quinchoId])
  @@index([fecha])
  @@index([estado])
  @@map("reservas")
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  RECHAZADA
}

// ═══════════════════
// INVITACIONES AL EVENTO
// ═══════════════════

model Invitacion {
  id            String    @id @default(cuid())
  codigo        String    @unique                    // para la URL pública
  titulo        String                                // "Boda de Ale y Anto"
  mensaje       String                                // texto de la invitación
  estilo        EstiloInvitacion @default(ELEGANTE)
  dressCode     String?   @map("dress_code")
  notas         String?                               // "No traer regalos" etc
  mostrarMapa   Boolean   @default(true) @map("mostrar_mapa")
  activa        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  reservaId     String    @unique @map("reserva_id")
  reserva       Reserva   @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  invitados     Invitado[]

  @@map("invitaciones")
}

enum EstiloInvitacion {
  ELEGANTE      // boda, aniversario
  FIESTA        // cumpleaños, celebración
  INFANTIL      // cumple de chicos
  CORPORATIVO   // evento de empresa
  CAMPESTRE     // asado, quincho
}

model Invitado {
  id              String          @id @default(cuid())
  token           String          @unique             // link personal, sin login
  nombre          String
  email           String?
  telefono        String?
  estado          EstadoInvitado  @default(PENDIENTE)
  acompanantes    Int             @default(0)
  mensaje         String?                             // lo que responde el invitado
  respondioEl     DateTime?       @map("respondio_el")
  enviadoEl       DateTime?       @map("enviado_el")
  createdAt       DateTime        @default(now()) @map("created_at")

  invitacionId    String          @map("invitacion_id")
  invitacion      Invitacion      @relation(fields: [invitacionId], references: [id], onDelete: Cascade)

  @@index([invitacionId])
  @@map("invitados")
}

enum EstadoInvitado {
  PENDIENTE
  CONFIRMADO
  RECHAZADO
}

// ═══════════════════
// RESEÑAS
// ═══════════════════

model Resena {
  id              String    @id @default(cuid())
  calificacion    Int
  comentario      String
  fecha           DateTime  @default(now())
  createdAt       DateTime  @default(now()) @map("created_at")

  usuarioId       String    @map("usuario_id")
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])
  quinchoId       String    @map("quincho_id")
  quincho         Quincho   @relation(fields: [quinchoId], references: [id])
  reservaId       String?   @unique @map("reserva_id")
  reserva         Reserva?  @relation(fields: [reservaId], references: [id])

  respuestaPropietario  String? @map("respuesta_propietario")

  @@index([quinchoId])
  @@index([usuarioId])
  @@map("resenas")
}

// ═══════════════════
// FAVORITOS
// ═══════════════════

model Favorito {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now()) @map("created_at")

  usuarioId   String    @map("usuario_id")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  quinchoId   String    @map("quincho_id")
  quincho     Quincho   @relation(fields: [quinchoId], references: [id])

  @@unique([usuarioId, quinchoId])
  @@map("favoritos")
}

// ═══════════════════
// DISPOSITIVOS (Push Notifications)
// ═══════════════════

model Dispositivo {
  id          String    @id @default(cuid())
  token       String    @unique                    // FCM token
  plataforma  String    @default("ios")            // "ios" | "android"
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  usuarioId   String    @map("usuario_id")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("dispositivos")
}
