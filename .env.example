# ─── Base de Datos PostgreSQL ───
# Opción 1: Neon (https://neon.tech) - Free tier 0.5GB
# Opción 2: Supabase (https://supabase.com) - Free tier 500MB
# Opción 3: Railway (https://railway.app) - Free trial
# Opción 4: Local: postgresql://user:pass@localhost:5432/quinchos
DATABASE_URL="postgresql://usuario:password@host:5432/quinchos?sslmode=require"

# ─── JWT ───
JWT_SECRET="cambiar-por-un-secreto-seguro-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

# ─── Server ───
PORT=3000
NODE_ENV=development

# ─── CORS ───
FRONTEND_URL="http://localhost:8081"
